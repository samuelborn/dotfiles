[global]
frame_color = "#89b4fa"
separator_color= frame
highlight = "#89b4fa"
font = Adwaita Sans 12
origin = top-left
timeout = 2
corner_radius = 6   

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#fab387"
