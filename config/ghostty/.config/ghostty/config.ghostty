keybind = performable:ctrl+c=copy_to_clipboard
theme = Catppuccin Mocha
background = #1D1D20
font-family = JetBrainsMono Nerd Font
font-size = 10.5
adjust-cell-height = 10%
window-padding-x = 6
window-padding-y = 6

# Tab bar lives in the titlebar at the top instead of a separate native tab strip
macos-titlebar-style = tabs
# Alt+<key> shortcuts in zsh and nvim; without this Option types special characters.
macos-option-as-alt = true
