keybind = performable:ctrl+c=copy_to_clipboard
theme = Catppuccin Mocha
background = #1D1D20
font-family = JetBrainsMono Nerd Font
font-size = 10.5
# Per-OS overrides, stowed only on that OS
config-file = ?macos.ghostty
adjust-cell-height = 10%
window-padding-x = 6
window-padding-y = 6

# Left Option acts as Alt in zsh/nvim; right Option types EurKEY umlauts
macos-option-as-alt = left

# Cmd+Q closes the window; app quits with the last one
keybind = cmd+q=close_window
quit-after-last-window-closed = true
# No close prompt; tmux survives
confirm-close-surface = false
# Windows, not tabs: AeroSpace tiles hidden tabs as empty windows
keybind = cmd+t=new_window
